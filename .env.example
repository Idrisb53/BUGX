# BUGX environment variables (all optional).
# Copy to .env only if your shell or tooling loads it. BUGX itself reads these
# from the process environment, e.g.:  export BUGX_HOME=/path/to/BUGX
#
# Never put real secrets in this file. .env is gitignored, .env.example is not.

# Project root containing config/ (default: the source checkout, else the cwd)
BUGX_HOME=/path/to/BUGX

# Where scans, findings, evidence, reports and logs are written
# (default: $BUGX_HOME/output)
BUGX_OUTPUT_DIR=/path/to/BUGX/output

# BUGX does not read API keys. Tools that need credentials use their own config:
#   Subfinder providers: ~/.config/subfinder/provider-config.yaml
#   Cloudlist providers: ~/.config/cloudlist/provider-config.yaml
